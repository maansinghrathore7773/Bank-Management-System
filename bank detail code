#include <iostream>
#include <fstream>
using namespace std;

struct Account {
    int id; char name[30]; double bal;
    void show() { cout << "\nAcc: " << id << " | Name: " << name << " | Balance: $" << bal << "\n"; }
};

void process(int id, int opt) {
    Account a;
    fstream f("bank.dat", ios::binary | ios::in | ios::out);
    while (f.read((char*)&a, sizeof(a))) {
        if (a.id == id) {
            if (opt == 2) a.show();
            else {
                double amt; cout << "Amount: $"; cin >> amt;
                if (opt == 3) a.bal += amt;
                if (opt == 4 && amt <= a.bal) a.bal -= amt;
                f.seekp(-(int)sizeof(a), ios::cur);
                f.write((char*)&a, sizeof(a));
                cout << "Done!\n";
            }
            f.close(); return;
        }
    }
    cout << "Not Found!\n"; f.close();
}

